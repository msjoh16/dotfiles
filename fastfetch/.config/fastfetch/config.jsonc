{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/gateway.png",
    "color": {
      "1": "#e35b15",
      "2": "#e35b15",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": ""
    },
    "width": 40,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 4
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": true,
    "hideCursor": false,
    "separator": " ➜  ",
    "color": {
      "keys": "",
      "title": "",
      "output": "",
      "separator": ""
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default"
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-"
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97"
      },
      "width": 10
    },
    "fraction": {
      "ndigits": 2
    },
    "noBuffer": false,
    "key": {
      "width": 0,
      "type": "string",
      "paddingLeft": 0
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "constants": []
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "30",
        "at": "30",
        "host": "30"
      }
    },
    {
      "type": "separator",
      "string": "-",
      "outputColor": "33",
      "times": 0
    },

    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "30",
      "keyIcon": ""
    },

    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": ""
    },

    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": " ├ 󰏖 ",
      "keyColor": "30",
      "keyIcon": " "
    },

    {
      "type": "shell",
      "key": " └  ",
      "keyColor": "30",
      "keyIcon": ""
    },

    "break",

    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "30",
      "keyIcon": "",
      "detectPlugin": true
    },

    {
      "type": "terminal",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": ""
    },

    {
      "type": "cursor",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": ""
    },

    {
      "type": "terminalfont",
      "key": " └  ",
      "keyColor": "30",
      "keyIcon": ""
    },

    "break",

    {
      "type": "host",
      "format": "{5} {1} Type {2}",
      "key": "PC   ",
      "keyColor": "30",      
      "keyIcon": ""
    },

    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7} GHz",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": "",
    },

    {
      "type": "gpu",
      "format": "{1} {2} @ {12} GHz",            
      "key": " ├ 󰢮 ",
      "keyColor": "30",
      "keyIcon": "" 
    },

    {
      "type": "memory",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": "",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },

    {
      "type": "swap",
      "key": " ├ 󰓡 ",
      "keyColor": "30",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      },
      "keyIcon": "",
      "separate": false
    },

    {
      "type": "disk",
      "key": " ├ 󰋊 ",
      "keyColor": "30",
      "keyIcon": "",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },

    {
      "type": "uptime",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": ""
    },

    {
      "type": "battery",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": "",
      "temp": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0
      }
    },
    
    {
      "type": "localip",
      "key": " ├ 󰩟 ",
      "keyColor": "30",
      "keyIcon": "",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "showPrefixLen": true,
      "showMtu": false,
      "showSpeed": false,
      "showFlags": false,
      "compact": false,
      "defaultRouteOnly": true,
      "showAllIps": false,
      "namePrefix": ""
    },

    {
      "type": "locale",
      "key": " ├  ",
      "keyColor": "30",
      "keyIcon": ""
    },

    {
      "type": "display",
      "key": " └  ",
      "keyColor": "30",
      "keyIcon": "",
      "compactType": "none",
      "preciseRefreshRate": false,
      "order": null
    },

    {
      "type": "de",
      "keyIcon": ""
    },

    {
      "type": "wmtheme",
      "keyIcon": "󰓸"
    },

    {
      "type": "theme",
      "keyIcon": "󰉼"
    },

    {
      "type": "icons",
      "keyIcon": ""
    },

    {
      "type": "poweradapter",
      "keyIcon": "󰚥"
    },

    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{#30}● {#31}● {#32}● {#33}● {#34}●{#}"
    }
  ]
}
